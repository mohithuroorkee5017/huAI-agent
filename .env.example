# Haridwar University AI - Environment Variables
# Copy this to .env and fill in your values

# ===================================
# REQUIRED: API & Authentication
# ===================================

# OpenRouter API Key (required for AI responses)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ===================================
# BACKEND CONFIGURATION
# ===================================

# Where FastAPI backend is running (change for production)
HARIDWAR_BACKEND_URL=http://127.0.0.1:8000

# Request timeout in seconds
OPENROUTER_REQUEST_TIMEOUT=30

# Number of retry attempts for backend calls
OPENROUTER_RETRY_ATTEMPTS=3

# ===================================
# FLASK CONFIGURATION
# ===================================

# Secret key for Flask sessions (use random string for production)
SECRET_KEY=change-this-to-random-secret-key-in-production

# Flask environment: development or production
FLASK_ENV=development

# Flask port
FLASK_PORT=5000

# ===================================
# OPTIONAL: Webhook Integration
# ===================================

# n8n webhook for integrations (optional)
WEBHOOK_URL=https://huassist2010.app.n8n.cloud/webhook/your-webhook-id

# ===================================
# OPTIONAL: Agent Configuration
# ===================================

# Agent display name
AGENT_NAME=HU Voice Agent

# Agent description
AGENT_DESCRIPTION=Intelligent multilingual AI assistant for students and professionals

# ===================================
# PRODUCTION DEPLOYMENT VALUES
# ===================================

# For Render.com:
# HARIDWAR_BACKEND_URL=https://haridwar-api.onrender.com
# FLASK_ENV=production

# For Railway.app:
# HARIDWAR_BACKEND_URL=https://your-project-api.railway.app
# FLASK_ENV=production

# For Vercel (not recommended):
# HARIDWAR_BACKEND_URL=https://your-project.vercel.app/api
# FLASK_ENV=production

# ===================================
# LOGGING
# ===================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file location
LOG_FILE=app.log

# ===================================
# DATABASE (Optional, for future use)
# ===================================

# DATABASE_URL=postgresql://user:password@localhost/haridwar_ai
# REDIS_URL=redis://localhost:6379

# ===================================
# NOTES FOR DEPLOYMENT
# ===================================

# 1. NEVER commit .env to GitHub
# 2. Always use strong SECRET_KEY for production
# 3. Keep API keys secret and rotate regularly
# 4. For production, set FLASK_ENV=production
# 5. Use proper HTTPS URLs in production
# 6. Monitor logs for errors

# ===================================
# DEPLOYMENT CHECKLIST
# ===================================

# [ ] Set OPENROUTER_API_KEY
# [ ] Set HARIDWAR_BACKEND_URL for production
# [ ] Generate strong SECRET_KEY
# [ ] Set FLASK_ENV=production
# [ ] Set LOG_LEVEL=INFO
# [ ] Test all endpoints
# [ ] Monitor logs
# [ ] Set up uptime monitoring
