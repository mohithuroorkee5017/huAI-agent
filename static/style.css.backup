/* HUVOICE AGENT - Main Styles */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 50%, #16213e 100%);
    min-height: 100vh;
    color: #e0e0e0;
}

/* Navbar */
.navbar {
    background: rgba(15, 15, 30, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 2px solid rgba(102, 126, 234, 0.4);
}

.navbar-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar-left h2 {
    color: #667eea;
    font-size: 1.5em;
    display: flex;
    align-items: center;
    gap: 10px;
}

.navbar-right {
    display: flex;
    align-items: center;
    gap: 20px;
}

.user-info {
    color: #a0aec0;
    font-weight: 600;
    font-size: 0.95em;
}

.btn-logout {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9em;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.btn-logout:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
}

.btn-logout:active {
    transform: translateY(0);
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Main Content */
.main-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
}

/* Header */
.header {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
    border-radius: 15px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    text-align: center;
    border: 1px solid rgba(102, 126, 234, 0.3);
}

.header-content h1 {
    color: #667eea;
    font-size: 2.5em;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
}

.header-content p {
    color: #a0aec0;
    font-size: 1.1em;
    margin-bottom: 15px;
}

.status-indicator {
    display: inline-block;
}

.status-badge {
    display: inline-block;
    padding: 8px 15px;
    border-radius: 20px;
    font-size: 0.9em;
    font-weight: 600;
    background: rgba(102, 126, 234, 0.2);
    color: #7dd3fc;
}

.status-badge.active {
    background: #d4edda;
    color: #155724;
}

.status-badge.listening {
    background: #fff3cd;
    color: #856404;
    animation: pulse 1s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

/* Control Panel */
.control-panel {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(102, 126, 234, 0.2);
}

.control-group {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

/* Buttons */
.btn {
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    font-size: 1em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
}

.btn-primary.recording {
    background: #dc3545;
    animation: pulse 0.5s infinite;
}

.btn-secondary {
    background: rgba(102, 126, 234, 0.2);
    color: #7dd3fc;
    border: 2px solid rgba(102, 126, 234, 0.4);
}

.btn-secondary:hover {
    background: rgba(102, 126, 234, 0.3);
    border-color: rgba(102, 126, 234, 0.6);
}

.btn-submit {
    background: #28a745;
    color: white;
    padding: 12px 30px;
}

.btn-submit:hover {
    background: #218838;
    transform: translateY(-2px);
}

.btn-small {
    padding: 6px 12px;
    font-size: 0.85em;
    background: rgba(102, 126, 234, 0.2);
    color: #7dd3fc;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-small:hover {
    background: rgba(102, 126, 234, 0.35);
}

.mic-icon {
    font-size: 1.2em;
}

.image-icon {
    font-size: 1.2em;
}

.button-group {
    display: flex;
    gap: 8px;
}

.btn-image-upload {
    background: rgba(102, 126, 234, 0.3);
    color: #7dd3fc;
    padding: 12px 12px;
    border: 2px solid rgba(102, 126, 234, 0.4);
    border-radius: 8px;
    font-size: 1.1em;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
}

.btn-image-upload:hover {
    background: rgba(102, 126, 234, 0.5);
    border-color: rgba(102, 126, 234, 0.8);
    transform: translateY(-2px);
}

.hidden-file-input {
    display: none;
}

.image-preview-container {
    position: relative;
    display: inline-block;
    margin-top: 10px;
    margin-bottom: 10px;
}

.preview-image {
    max-width: 150px;
    max-height: 150px;
    border-radius: 8px;
    border: 2px solid rgba(102, 126, 234, 0.5);
    object-fit: cover;
}

.btn-remove-preview {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #e74c3c;
    color: white;
    border: none;
    font-size: 1.2em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.btn-remove-preview:hover {
    background: #c0392b;
    transform: scale(1.1);
}

/* Input Section */
.input-section {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(102, 126, 234, 0.2);
    order: 10;
    margin-top: auto;
}

.input-group {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
}

.input-field {
    flex: 1;
    padding: 15px;
    border: 2px solid rgba(102, 126, 234, 0.3);
    border-radius: 8px;
    font-size: 1em;
    transition: border-color 0.3s ease;
    background: rgba(26, 26, 46, 0.7);
    color: #e0e0e0;
}

.input-field:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.input-hint {
    font-size: 0.9em;
    color: #718096;
    text-align: center;
}

/* Conversation Section */
.conversation-section {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(102, 126, 234, 0.2);
}

.conversation-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid rgba(102, 126, 234, 0.2);
}

.conversation-header h3 {
    color: #667eea;
}

.conversation-box {
    max-height: 400px;
    overflow-y: auto;
    padding: 15px;
    background: rgba(15, 15, 30, 0.6);
    border-radius: 8px;
}

.welcome-message {
    text-align: center;
    color: #4a5568;
    padding: 20px;
}

.welcome-message p {
    margin: 10px 0;
}

/* Message Bubbles */
.message {
    margin-bottom: 15px;
    animation: slideIn 0.3s ease;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message-bubble {
    padding: 12px 15px;
    border-radius: 12px;
    word-wrap: break-word;
    max-width: 85%;
}

.user-message {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    margin-left: auto;
    text-align: right;
}

.agent-message {
    background: rgba(102, 126, 234, 0.2);
    color: #cbd5e0;
    margin-right: auto;
}

.message-time {
    font-size: 0.8em;
    opacity: 0.7;
    margin-top: 5px;
}

/* Transcript Section */
.transcript-section {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(102, 126, 234, 0.2);
}

.transcript-section h3 {
    color: #667eea;
    margin-bottom: 15px;
}

.transcript-box {
    background: rgba(15, 15, 30, 0.6);
    padding: 15px;
    border-radius: 8px;
    border-left: 4px solid #667eea;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    max-height: 150px;
    overflow-y: auto;
    color: #a0aec0;
}

.transcript-empty {
    color: #4a5568;
    font-style: italic;
}

/* Loading Indicator */
.loading-indicator {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: rgba(15, 15, 30, 0.95);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f0f0f0;
    border-top: 4px solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Scrollbar */
.conversation-box::-webkit-scrollbar {
    width: 8px;
}

.conversation-box::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 10px;
}

.conversation-box::-webkit-scrollbar-thumb {
    background: #667eea;
    border-radius: 10px;
}

.conversation-box::-webkit-scrollbar-thumb:hover {
    background: #764ba2;
}

/* ============================================
   RESPONSIVE DESIGN - MOBILE FIRST
   ============================================ */

/* Mobile: 320px - 480px */
@media (max-width: 480px) {
    body {
        font-size: 14px;
    }

    .container {
        padding: 10px;
    }

    .navbar-content {
        padding: 12px 10px;
        flex-direction: column;
        gap: 10px;
    }

    .navbar-left h2 {
        font-size: 1.1em;
        gap: 5px;
    }

    .navbar-right {
        width: 100%;
        justify-content: space-between;
        gap: 10px;
    }

    .user-info {
        font-size: 0.8em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-logout {
        padding: 6px 15px;
        font-size: 0.8em;
    }

    .header {
        padding: 15px;
        border-radius: 10px;
    }

    .header-content h1 {
        font-size: 1.5em;
        margin-bottom: 5px;
    }

    .header-content p {
        font-size: 0.95em;
    }

    .status-badge {
        padding: 6px 12px;
        font-size: 0.8em;
    }

    .control-group {
        flex-direction: column;
        gap: 10px;
    }

    .btn {
        width: 100%;
        padding: 10px 15px;
        font-size: 0.9em;
        min-height: 44px;
    }

    .input-section {
        padding: 15px;
    }

    .input-group {
        flex-direction: column;
        gap: 8px;
    }

    .input-field {
        padding: 12px;
        font-size: 1em;
    }

    .input-hint {
        font-size: 0.8em;
    }

    .conversation-section {
        padding: 15px;
    }

    .conversation-box {
        max-height: 300px;
        padding: 10px;
    }

    .message-bubble {
        max-width: 95%;
        padding: 10px 12px;
        font-size: 0.9em;
    }

    .message-time {
        font-size: 0.75em;
    }

    .transcript-section {
        padding: 15px;
    }

    .transcript-box {
        max-height: 120px;
        padding: 10px;
        font-size: 0.85em;
    }

    .loading-indicator {
        bottom: 10px;
        right: 10px;
        padding: 15px;
    }

    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid rgba(102, 126, 234, 0.2);
        border-top: 3px solid #667eea;
    }
}

/* Small Tablets: 481px - 768px */
@media (min-width: 481px) and (max-width: 768px) {
    body {
        font-size: 15px;
    }

    .container {
        padding: 15px;
    }

    .navbar-content {
        padding: 14px 15px;
    }

    .navbar-left h2 {
        font-size: 1.3em;
    }

    .navbar-right {
        gap: 15px;
    }

    .user-info {
        font-size: 0.9em;
    }

    .btn-logout {
        padding: 8px 18px;
        font-size: 0.9em;
    }

    .header {
        padding: 20px;
        border-radius: 12px;
    }

    .header-content h1 {
        font-size: 2em;
    }

    .header-content p {
        font-size: 1em;
    }

    .control-group {
        flex-direction: column;
        gap: 12px;
    }

    .btn {
        width: 100%;
        padding: 11px 20px;
        font-size: 0.95em;
        min-height: 44px;
    }

    .input-section {
        padding: 18px;
    }

    .input-group {
        flex-direction: column;
        gap: 10px;
    }

    .input-field {
        padding: 12px;
        font-size: 1em;
    }

    .conversation-box {
        max-height: 350px;
        padding: 12px;
    }

    .message-bubble {
        max-width: 90%;
        padding: 11px 14px;
        font-size: 0.95em;
    }

    .transcript-box {
        max-height: 130px;
        font-size: 0.9em;
    }

    .loading-indicator {
        bottom: 20px;
        right: 20px;
    }
}

/* Tablets & Medium Devices: 769px - 1024px */
@media (min-width: 769px) and (max-width: 1024px) {
    body {
        font-size: 16px;
    }

    .container {
        padding: 20px;
        max-width: 95%;
    }

    .navbar-content {
        padding: 15px 20px;
    }

    .navbar-left h2 {
        font-size: 1.4em;
    }

    .header {
        padding: 25px;
    }

    .header-content h1 {
        font-size: 2.2em;
    }

    .control-group {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn {
        flex: 1;
        min-width: 150px;
        min-height: 44px;
    }

    .input-group {
        flex-direction: row;
        gap: 12px;
    }

    .input-field {
        flex: 1;
    }

    .conversation-box {
        max-height: 400px;
    }

    .message-bubble {
        max-width: 85%;
    }
}

/* Large Tablets & Desktops: 1025px - 1440px */
@media (min-width: 1025px) and (max-width: 1440px) {
    .container {
        max-width: 1000px;
        padding: 25px;
    }

    .navbar-content {
        max-width: 1000px;
    }

    .header-content h1 {
        font-size: 2.5em;
    }

    .control-group {
        flex-direction: row;
        gap: 20px;
    }

    .btn {
        flex: 1;
        min-height: 48px;
    }

    .message-bubble {
        max-width: 80%;
    }
}

/* Large Desktops & Ultra-wide: 1441px+ */
@media (min-width: 1441px) {
    .container {
        max-width: 1200px;
        padding: 30px;
    }

    .navbar-content {
        max-width: 1200px;
    }

    .header {
        padding: 35px;
    }

    .header-content h1 {
        font-size: 2.8em;
    }

    .btn {
        min-height: 50px;
    }

    .message-bubble {
        max-width: 75%;
    }
}

/* ============================================
   TOUCH DEVICE OPTIMIZATION
   ============================================ */
@media (hover: none) and (pointer: coarse) {
    /* Mobile touch devices */
    .btn,
    .btn-logout,
    .btn-primary,
    .btn-secondary,
    .btn-small {
        min-height: 44px;
        min-width: 44px;
        padding: 12px 20px;
        tap-highlight-color: transparent;
        -webkit-tap-highlight-color: transparent;
    }

    .btn:active,
    .btn-logout:active {
        opacity: 0.8;
    }

    .input-field,
    textarea {
        font-size: 16px;
        padding: 15px;
    }

    .message-bubble {
        padding: 15px;
    }
}

/* ============================================
   LANDSCAPE ORIENTATION (Mobile)
   ============================================ */
@media (max-height: 600px) and (orientation: landscape) {
    .container {
        min-height: auto;
        padding: 10px;
    }

    .header {
        padding: 12px;
        margin-bottom: 10px;
    }

    .header-content h1 {
        font-size: 1.4em;
        margin-bottom: 3px;
    }

    .header-content p {
        font-size: 0.9em;
        margin-bottom: 8px;
    }

    .control-group {
        gap: 8px;
    }

    .btn {
        padding: 8px 15px;
        font-size: 0.85em;
    }

    .conversation-box {
        max-height: 250px;
    }

    .input-section {
        margin-top: 10px;
    }
}

/* ============================================
   HIGH DPI / RETINA DISPLAYS
   ============================================ */
@media (min-device-pixel-ratio: 2),
       (min-resolution: 192dpi) {
    .btn,
    .input-field,
    .message-bubble {
        border-width: 0.5px;
    }

    .spinner {
        border-width: 2px;
    }
}
