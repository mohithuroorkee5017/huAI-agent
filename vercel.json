{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt && pip install -r api/requirements.txt",
  "env": {
    "OPENROUTER_API_KEY": "@openrouter_api_key",
    "HUVOICE_BACKEND_URL": "@huvoice_backend_url",
    "FLASK_ENV": "production",
    "SECRET_KEY": "@secret_key"
  },
  "functions": {
    "api/main.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "huvoice_agent.py": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
